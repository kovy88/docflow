# ollama (local, default), openrouter (hosted Qwen, production) or openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.8:27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# SQLite locally; production: Supabase Postgres in its own schema
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./docflow.db
DB_SCHEMA=

# Production guard: uploads/extractions need this code (X-Access-Code header); empty = open
ACCESS_CODE=
DAILY_LLM_LIMIT=100
CORS_ORIGINS=http://localhost:3000
