# ollama (local, default), openrouter (hosted Qwen, production) or openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.6:35b-a3b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# SQLite locally; production: Supabase Postgres in its own schema
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./docflow.db
DB_SCHEMA=

# Production guard: uploads/extractions need this code (X-Access-Code header); empty = open
ACCESS_CODE=
# Pilot deployments refuse to start without a non-empty code.
PILOT_MODE=false
DAILY_LLM_LIMIT=100
CORS_ORIGINS=http://localhost:3000

# Public trial page (/vyzkouset): limits per rolling 24 h, data deleted after TRIAL_RETENTION_H
TRIAL_ENABLED=true
TRIAL_MAX_MB=10
TRIAL_MAX_PAGES=10
TRIAL_PER_IP=3
TRIAL_DAILY_LIMIT=30
TRIAL_RETENTION_H=24
# Header with the visitor IP from the hosting proxy (empty = socket address); salt for its hash
CLIENT_IP_HEADER=
IP_HASH_SALT=
# Integrator API (/v1) upload limits; keys: uv run python scripts/api_keys.py create "Klient"
API_MAX_MB=20
API_MAX_PAGES=50
# E-mail intake: an IMAP mailbox; a firm sends PDFs to <local>+<token>@<domain> of
# INTAKE_ADDRESS (token: scripts/workspaces.py intake <id>). Off while any is empty. A shared
# mailbox is fine: only unread mail to <local>+<token>@ of the last 7 days is touched.
INTAKE_ADDRESS=
INTAKE_IMAP_HOST=
INTAKE_IMAP_PORT=993
INTAKE_IMAP_USER=
INTAKE_IMAP_PASSWORD=
INTAKE_IMAP_FOLDER=INBOX
INTAKE_POLL_S=120
