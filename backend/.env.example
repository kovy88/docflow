# Copy to .env and fill in as needed. Every setting has a working default for
# local development (see src/docflow/config.py) — you only need to set the
# keys that differ from the default, most commonly just an LLM API key.
#
# Docker Compose does not read this file directly; it sets these same
# variables itself in docker-compose.yml. This file is for running the API
# or worker directly on the host with `uv run`. See docs/LOCAL_DEVELOPMENT.md.

DOCFLOW_ENVIRONMENT=local

# --- Database ----------------------------------------------------------------
# Matches docker-compose.yml's postgres service (host port 5433, not 5432, so
# it never collides with a Postgres you already run).
DOCFLOW_DB_URL=postgresql+asyncpg://docflow:docflow@localhost:5433/docflow

# --- Redis ---------------------------------------------------------------------
# Matches docker-compose.yml's redis service (host port 6380).
DOCFLOW_REDIS_URL=redis://localhost:6380/0

# --- Object storage ------------------------------------------------------------
# "local" writes to DOCFLOW_STORAGE_LOCAL_ROOT on disk — fine for development,
# not supported in production (see Settings.validate_for_environment). Switch
# to "s3" and fill in the fields below for anything S3-compatible (AWS S3,
# Cloudflare R2, Supabase Storage, MinIO).
DOCFLOW_STORAGE_BACKEND=local
DOCFLOW_STORAGE_LOCAL_ROOT=./.data/storage
# DOCFLOW_STORAGE_BACKEND=s3
# DOCFLOW_STORAGE_BUCKET=docflow
# DOCFLOW_STORAGE_ENDPOINT_URL=
# DOCFLOW_STORAGE_ACCESS_KEY_ID=
# DOCFLOW_STORAGE_SECRET_ACCESS_KEY=

# --- Security --------------------------------------------------------------
# The default below is fine for local dev ONLY — startup refuses to boot with
# it when DOCFLOW_ENVIRONMENT=production. Generate a real one for anything
# else: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
DOCFLOW_SECURITY_JWT_SECRET=dev-only-insecure-secret-change-me
# Comma-separated, not JSON.
DOCFLOW_SECURITY_CORS_ORIGINS=http://localhost:3000

# --- LLM provider ------------------------------------------------------------
# "fixture" (default) needs no API key: a deterministic rule-based stand-in
# that exercises the full pipeline for tests, CI, and offline demos. Set to
# "anthropic", "openai", or "google" and supply the matching key to use a
# real model.
DOCFLOW_LLM_PROVIDER=fixture
DOCFLOW_LLM_MODEL=claude-opus-5
# DOCFLOW_LLM_ANTHROPIC_API_KEY=sk-ant-...
# DOCFLOW_LLM_OPENAI_API_KEY=sk-...
# DOCFLOW_LLM_GOOGLE_API_KEY=...
# DOCFLOW_LLM_MODEL=gemini-3.6-flash   # when DOCFLOW_LLM_PROVIDER=google

# --- Observability -----------------------------------------------------------
# "console" is human-readable for local dev; "json" (production default) is
# what the structured-logging/correlation-id story in docs/ARCHITECTURE.md
# describes.
DOCFLOW_OBS_LOG_FORMAT=console
