# Copy to .env.local for `npm run dev`. Defaults to http://localhost:8000 if unset.
#
# NEXT_PUBLIC_* variables are inlined into the client JS bundle at BUILD time,
# not read at container/server start. For `npm run dev` that just means restart
# the dev server after changing this file; for a Docker build it means this
# must be passed as `--build-arg NEXT_PUBLIC_API_URL=...`, not a runtime `-e`
# flag — see frontend/Dockerfile and docker-compose.yml for why.
NEXT_PUBLIC_API_URL=http://localhost:8000
